import math
gammas = [14.134725, 21.022040, 25.010858, 30.424876, 32.935062]

def Z_partial(x, n):
return -sum((2*x)/(x**2 + gammas[k]**2) for k in range(n))

print("--- Z(12) ---")
for n in [1,2,3,4,5]:
print(f"n={n} Z(12)={Z_partial(12.0,n):.6f}")

c2 = 0.5*sum(math.log(g)/(g**4) for g in gammas)
print(f"\n--- c2 ---\nc2 = {c2:.8e}")
print(f"Required scale for 2.31 TeV = {2.31/c2:.4e} TeV")

t5 = 32.935062
z2 = sum(4*t5*(3*g**2 - t5**2)/(t5**2+g**2)**3 for g in gammas)
print(f"\n--- Z''(t5) ---\nZ'' = {z2:.10e}")