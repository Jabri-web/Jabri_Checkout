import numpy as np
import mpmath as mp
import matplotlib.pyplot as plt
from scipy.optimize import brentq

mp.mp.dps = 30

# تعديل جوهري: نأخذ الجزء التخيلي (Imaginary) الذي يحتوي على أصفار ريمان
def Zx_imag(x):
    s = 0.5 + 1j*x
    h = 1e-5
    log_zeta_prime = (mp.log(mp.zeta(s + 1j*h)) - mp.log(mp.zeta(s - 1j*h))) / (2j*h)
    # نأخذ الجزء التخيلي بدلاً من الحقيقي
    return float(0.5 * (x**2) * log_zeta_prime.imag)

def Zx_imag_prime(x):
    h = 1e-4
    return (Zx_imag(x + h) - Zx_imag(x - h)) / (2 * h)

print("جاري مسح الدالة الجديدة Zx_imag(x) في المجال [10, 50]...")
x_vals = np.linspace(10, 50, 4000)

def find_zeros(func, x_arr, y_arr):
    zeros = []
    for i in range(len(x_arr)-1):
        if y_arr[i] * y_arr[i+1] < 0:
            try:
                root = brentq(func, x_arr[i], x_arr[i+1])
                if not any(abs(root - r) < 1e-4 for r in zeros):
                    zeros.append(root)
            except:
                pass
    return zeros

z_vals = [Zx_imag(x) for x in x_vals]
zp_vals = [Zx_imag_prime(x) for x in x_vals]

zeros_Z = find_zeros(Zx_imag, x_vals, z_vals)
zeros_Zp = find_zeros(Zx_imag_prime, x_vals, zp_vals)

print(f"\n1. أصفار الدالة Zx_imag(x):")
for i, z in enumerate(zeros_Z):
    print(f"   Zero {i+1}: x = {z:.6f}")

print(f"\n2. أصفار المشتقة Zx_imag'(x):")
for i, z in enumerate(zeros_Zp[:10]):
    print(f"   Critical Point {i+1}: x = {z:.6f}")

# الرسم
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))

ax1.plot(x_vals, z_vals, 'b-', label='Zx_imag(x)')
for z in zeros_Z:
    ax1.axvline(z, color='r', linestyle='--', alpha=0.5)
ax1.set_title("Zx_imag(x) (The Imaginary Part) and its Zeros (Red)")
ax1.grid(True)

ax2.plot(x_vals, zp_vals, 'g-', label="Zx_imag'(x)")
for z in zeros_Zp:
    ax2.axvline(z, color='orange', linestyle='--', alpha=0.5)
ax2.set_title("First Derivative Zx_imag'(x) and its Zeros (Orange)")
ax2.grid(True)

plt.tight_layout()
plt.show()


