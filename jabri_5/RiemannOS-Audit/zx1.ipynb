import numpy as np
import mpmath as mp
import matplotlib.pyplot as plt

mp.mp.dps = 30

# 1. الدالة الأساسية (الجزء التخيلي)
def Zx_imag(x):
    s = 0.5 + 1j*x
    h = 1e-5
    log_zeta_prime = (mp.log(mp.zeta(s + 1j*h)) - mp.log(mp.zeta(s - 1j*h))) / (2j*h)
    return float(0.5 * (x**2) * log_zeta_prime.imag)

# 2. المشتقة العددية للدالة
def Zx_imag_prime(x):
    h = 1e-4
    return (Zx_imag(x + h) - Zx_imag(x - h)) / (2 * h)

# 3. الدالة العكسية في إطار DIA
def Rx(x):
    z = Zx_imag(x)
    zp = Zx_imag_prime(x)
    if abs(zp) < 1e-12: return np.nan # حماية من القسمة على صفر
    return z / zp

# القيم التي استخرجناها سابقاً (للمقارنة البصرية)
true_zeros = [10.212075, 17.882582, 23.104651, 27.735883, 31.697930]
riemann_poles = [14.134725, 21.022040, 25.010858, 30.424876, 32.935062]

print("جاري رسم الدالة العكسية Rx(x)...")
x_vals = np.linspace(10, 35, 2000)
rx_vals = [Rx(x) for x in x_vals]

# الرسم
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10))

# اللوحة العلوية: الدالة الأصلية Zx
ax1.plot(x_vals, [Zx_imag(x) for x in x_vals], 'b-', label='Zx(x)')
for z in true_zeros: ax1.axvline(z, color='red', linestyle='--')
for p in riemann_poles: ax1.axvline(p, color='green', linestyle=':')
ax1.set_title("Original Function: Zeros (Red) and Poles (Green)")
ax1.set_ylim(-50, 50)
ax1.grid(True)

# اللوحة السفلية: الدالة العكسية Rx
ax2.plot(x_vals, rx_vals, 'purple', label='Rx(x) = Zx/Zx\'')
for p in riemann_poles: ax2.axvline(p, color='green', linestyle=':')
for z in true_zeros: ax2.axvline(z, color='red', linestyle='--')

# نضع علامة على الصفر لمقارنة التقاطع
ax2.axhline(0, color='black', linewidth=1)
ax2.set_title("DIA Inverse Function: Poles become Zeros, Zeros become Poles")
ax2.set_ylim(-0.5, 0.5) # نركز على الصفر لنرى التقاطع
ax2.grid(True)

plt.tight_layout()
plt.show()


