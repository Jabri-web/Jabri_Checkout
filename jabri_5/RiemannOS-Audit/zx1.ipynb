import numpy as np
import mpmath as mp
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

mp.mp.dps = 30

print("="*50)
print("التجربة 1: تطبيق DIA على دالة زيتا (Riemann Zeta)")
print("="*50)

# 1. تعريف دالة زيتا F(z) ومشتقتها F'(z) ومقلوب مشتقتها R(z)
def Zeta(z): return mp.zeta(z)
def Zeta_prime(z): return mp.zeta(z, 1) # المشتقة الأولى لزيتا في mpmath
def R_zeta(z): return Zeta(z) / Zeta_prime(z) # الدالة العكسية
def D_zeta(z): return Zeta_prime(z) / Zeta(z) # البصمة اللوغاريتمية

# الصفر الأول لزيتا على الخط الحرج
rho_1 = 0.5 + 14.1347251417j

print(f"\n1. القيمة عند الصفر الأول (z = {rho_1}):")
print(f"Zeta(z) = {mp.nstr(Zeta(rho_1), 5)}")
print(f"R(z) = {mp.nstr(R_zeta(rho_1), 5)} (متوقع: 0)")

# 2. إيجاد التعددية (Residue) حول الصفر الأول
# نستخدم مبدأ الحجة (نصف قطر صغير جداً حول الصفر)
radius = 1e-4
def residue_DIA(func_D, center, r):
    integrand = lambda t: func_D(center + r * mp.exp(1j * t)) * 1j * r * mp.exp(1j * t)
    return mp.quad(integrand, [0, 2*mp.pi]) / (2j * mp.pi)

res_zeta = residue_DIA(D_zeta, rho_1, radius)
print(f"\n2. التعددية (Residue) حول الصفر الأول:")
print(f"التكامل العقدي لـ D(z) يعطي: {mp.nstr(res_zeta, 10)} (متوقع: 1)")

print("\n" + "="*50)
print("التجربة 2: المشهد الطيفي لزيتا (Spectral Landscape)")
print("="*50)
# رسم |D(z)| في المستوى العقدي لنرى الأصفار كجبال
x_vals = np.linspace(0.1, 0.9, 100)
y_vals = np.linspace(10, 35, 200) # نبحث بين الصفر الأول والثالث
X, Y = np.meshgrid(x_vals, y_vals)

# نحسب |D(z)| للرسم (نستخدم numpy لتسريع الرسم)
# ملاحظة: numpy لا يحتوي على دالة زيتا مباشرة، لذا سنستخدم تقريباً سريعاً أو نرسم دالة Zx الخاصة بك
# للتبسيط، سنرسم الدالة Zx التي كتبتها أنت في كودك الأول
def Zx_func(x):
    # تقريب باستخدام mpmath في نقطة واحدة (بطيء للرسم)، لذا سنرسم الدالة Zx(x) كمنحنى 1D
    s = 0.5 + 1j*x
    # مشتقة لوغاريتمية
    log_zeta_prime = (mp.log(mp.zeta(s + 1e-5)) - mp.log(mp.zeta(s - 1e-5))) / (2e-5 * 1j)
    return 0.5 * (x**2) * log_zeta_prime.real

print("\n" + "="*50)
print("التجربة 3: تحليل الدالة Zx(x) التي كتبتها أنت")
print("="*50)

# الدالة الأصلية Zx(x)
def Zx(x): return Zx_func(x)

# المشتقة العددية لـ Zx(x)
def Zx_prime(x):
    h = 1e-5
    return (Zx(x + h) - Zx(x - h)) / (2 * h)

# مقلوب المشتقة Rx(x) = Zx / Zx'
def Rx(x):
    z_val = Zx(x)
    zp_val = Zx_prime(x)
    if abs(zp_val) < 1e-15: return mp.inf
    return z_val / zp_val

# اختبر القيم عند أول صفرين لريمان
gamma_1 = 14.134725
gamma_2 = 21.022040

print(f"\nعند الصفر الأول (x = {gamma_1}):")
print(f"Zx(x) = {mp.nstr(Zx(gamma_1), 5)}")
print(f"Zx'(x) = {mp.nstr(Zx_prime(gamma_1), 5)}")
print(f"Rx(x) = Zx/Zx' = {mp.nstr(Rx(gamma_1), 5)}")

print(f"\nعند الصفر الثاني (x = {gamma_2}):")
print(f"Zx(x) = {mp.nstr(Zx(gamma_2), 5)}")
print(f"Zx'(x) = {mp.nstr(Zx_prime(gamma_2), 5)}")
print(f"Rx(x) = Zx/Zx' = {mp.nstr(Rx(gamma_2), 5)}")

# رسم الدالة Zx(x) ومقلوبها Rx(x) لرؤية السلوك البصري
x_plot = np.linspace(10, 25, 200)
Zx_vals = [float(Zx(x)) for x in x_plot]
Rx_vals = [float(Rx(x)) for x in x_plot]

fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))

ax1.plot(x_plot, Zx_vals, 'b-', label='Zx(x)')
ax1.axvline(gamma_1, color='r', linestyle='--', label=f'Zero 1 ({gamma_1})')
ax1.axvline(gamma_2, color='g', linestyle='--', label=f'Zero 2 ({gamma_2})')
ax1.set_title("Zx(x) Function")
ax1.legend()
ax1.grid(True)

ax2.plot(x_plot, Rx_vals, 'm-', label='Rx(x) = Zx/Zx\'')
ax2.axhline(0, color='k', linestyle='-')
ax2.axvline(gamma_1, color='r', linestyle='--', label=f'Zero 1')
ax2.axvline(gamma_2, color='g', linestyle='--', label=f'Zero 2')
ax2.set_title("Inverse Function Rx(x) = Zx/Zx'")
ax2.legend()
ax2.grid(True)
ax2.set_ylim(-1, 1) # تقييد الرسم لرؤية التقاطع مع الصفر

plt.tight_layout()
plt.show()



