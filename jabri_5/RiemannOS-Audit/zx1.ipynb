import numpy as np
import mpmath as mp
import matplotlib.pyplot as plt

mp.mp.dps = 30

# دالة Zx_imag (التي تعزل الجزء التخيلي)
def Zx_imag(x):
    s = 0.5 + 1j*x
    h = 1e-5
    log_zeta_prime = (mp.log(mp.zeta(s + 1j*h)) - mp.log(mp.zeta(s - 1j*h))) / (2j*h)
    return float(0.5 * (x**2) * log_zeta_prime.imag)

print("جاري مسح الدالة Zx_imag(x) في المجال [10, 50]...")
x_vals = np.linspace(10, 50, 4000)
z_vals = [Zx_imag(x) for x in x_vals]

# ==========================================
# الأداة الذكية: الفصل بين الأصفار والأقطاب
# ==========================================
def classify_points(func, x_arr, y_arr):
    true_zeros = []
    poles = []
    
    for i in range(len(x_arr)-1):
        # هل هناك تغير في الإشارة؟
        if y_arr[i] * y_arr[i+1] < 0:
            try:
                # نبحث عن الجذر بدقة
                root = mp.findroot(func, (x_arr[i], x_arr[i+1]))
                root_val = float(root)
                
                # المعيار الذكي: هل القيمة المطلقة للدالة صغيرة أم ضخمة؟
                # نقيّم الدالة حول الجذر بـ 1e-3
                val_left = abs(func(root_val - 0.001))
                val_right = abs(func(root_val + 0.001))
                
                # إذا كانت القيم ضخمة جداً، فهذا قطب (صفر لريمان)
                if val_left > 1000 or val_right > 1000:
                    if not any(abs(root_val - p) < 1e-3 for p in poles):
                        poles.append(root_val)
                else:
                    # إذا كانت القيم صغيرة، فهذا صفر حقيقي (نقطة سكون)
                    if not any(abs(root_val - z) < 1e-3 for z in true_zeros):
                        true_zeros.append(root_val)
            except:
                pass
                
    return true_zeros, poles

zeros, poles = classify_points(Zx_imag, x_vals, z_vals)

print("\n" + "="*50)
print("النتائج المصنفة آلياً (بدون تدخل بشري):")
print("="*50)

print("\n1. الأصفار الحقيقية لـ Zx_imag (حيث Zx = 0):")
print("   (هذه هي نقاط السكون Z'(x) = 0 لدالة هاردي)")
for i, z in enumerate(zeros[:10]):
    print(f"   Zero {i+1}: x = {z:.6f}")

print("\n2. الأقطاب (حيث Zx تسعى للانهاية):")
print("   (هذه هي أصفار ريمان الحقيقية حيث Z(x) = 0)")
for i, p in enumerate(poles[:10]):
    print(f"   Pole {i+1}: x = {p:.6f}")

# ==========================================
# الرسم (سنجعل كل نوع بلون مختلف)
# ==========================================
plt.figure(figsize=(14, 6))
plt.plot(x_vals, z_vals, 'b-', label='Zx_imag(x)', lw=1)

# خطوط حمراء للأصفار الحقيقية
for z in zeros:
    plt.axvline(z, color='red', linestyle='--', label='True Zero' if z == zeros[0] else "")
    
# خطوط خضراء للأقطاب (أصفار ريمان)
for p in poles:
    plt.axvline(p, color='green', linestyle=':', label='Pole (Zeta Zero)' if p == poles[0] else "")

plt.ylim(-20, 20) # نحدد النطاق لنرى تقاطع الأصفار
plt.title("DIA Classification: Separating True Zeros (Red) from Poles (Green)")
plt.xlabel("x")
plt.ylabel("Zx_imag(x)")
plt.legend(loc='upper right')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()



