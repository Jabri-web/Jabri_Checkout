import numpy as np
import mpmath as mp
import matplotlib.pyplot as plt
from scipy.optimize import brentq

mp.mp.dps = 30

# ==========================================
# 1. تعريف الدالة Zx(x) بالمسار الحقيقي (Real)
# ==========================================
def Zx(x):
    s = 0.5 + 1j*x
    h = 1e-5
    log_zeta_prime = (mp.log(mp.zeta(s + 1j*h)) - mp.log(mp.zeta(s - 1j*h))) / (2j*h)
    # نأخذ الجزء الحقيقي كما في كودك الأصلي
    return float(0.5 * (x**2) * log_zeta_prime.real)

# ==========================================
# 2. حساب المشتقات والنسب
# ==========================================
def Zx_prime(x):
    h = 1e-4
    return (Zx(x + h) - Zx(x - h)) / (2 * h)

def Zx_double_prime(x):
    h = 1e-4
    return (Zx(x + h) - 2*Zx(x) + Zx(x - h)) / (h**2)

def Rx(x):
    z = Zx(x)
    zp = Zx_prime(x)
    if abs(zp) < 1e-12: return np.nan
    return z / zp

def Dx(x):
    z = Zx(x)
    zp = Zx_prime(x)
    if abs(z) < 1e-12: return np.nan
    return zp / z

# ==========================================
# 3. مسح المجال واكتشاف البنية (بدون أي افتراضات)
# ==========================================
print("جاري مسح الدالة Zx(x) في المجال [10, 50]...")
x_vals = np.linspace(10, 50, 4000)

def find_zeros(func, x_arr, y_arr):
    zeros = []
    for i in range(len(x_arr)-1):
        if y_arr[i] * y_arr[i+1] < 0:
            try:
                root = brentq(func, x_arr[i], x_arr[i+1])
                if not any(abs(root - r) < 1e-4 for r in zeros):
                    zeros.append(root)
            except:
                pass
    return zeros

# حساب القيم
z_values = [Zx(x) for x in x_vals]
zp_values = [Zx_prime(x) for x in x_vals]

# استخراج البنية
zeros_Z = find_zeros(Zx, x_vals, z_values)
zeros_Zp = find_zeros(Zx_prime, x_vals, zp_values)

print("\n" + "="*50)
print("النتائج المستقلة (ماذا أنتجت Zx دون تدخل؟)")
print("="*50)

print(f"\n1. أصفار الدالة Zx(x) (حيث Zx = 0):")
if len(zeros_Z) == 0:
    print("   (لا توجد أصفار في هذا النطاق)")
else:
    for i, z in enumerate(zeros_Z):
        print(f"   Zero {i+1}: x = {z:.6f}")

print(f"\n2. أصفار المشتقة Zx'(x) (حيث Zx' = 0):")
if len(zeros_Zp) == 0:
    print("   (لا توجد نقاط حرجة في هذا النطاق)")
else:
    for i, z in enumerate(zeros_Zp[:10]):
        print(f"   Critical Point {i+1}: x = {z:.6f}")

# ==========================================
# 4. الرسم البصري للبنية
# ==========================================
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))

# اللوحة الأولى: Zx وأصفارها
ax1.plot(x_vals, z_values, 'b-', label='Zx(x)')
for z in zeros_Z:
    ax1.axvline(z, color='r', linestyle='--', alpha=0.5)
ax1.set_title("Zx(x) (Real Part) and its Independant Zeros (Red)")
ax1.set_ylabel("Zx(x)")
ax1.grid(True)
ax1.legend()

# اللوحة الثانية: المشتقة Zx' وأصفارها
ax2.plot(x_vals, zp_values, 'g-', label="Zx'(x)")
for z in zeros_Zp:
    ax2.axvline(z, color='orange', linestyle='--', alpha=0.5)
ax2.set_title("First Derivative Zx'(x) and its Independant Zeros (Orange)")
ax2.set_ylabel("Zx'(x)")
ax2.grid(True)
ax2.legend()

plt.tight_layout()
plt.show()




