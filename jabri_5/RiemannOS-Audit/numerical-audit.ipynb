import math

# First five zeros - التعريف الصحيح
gammas = [14.134725, 21.022040, 25.010858, 30.424876, 32.935062]
gamma1 = gammas[0]
gamma5 = gammas[4]

print(f"Loaded {len(gammas)} zeros")
for i, g in enumerate(gammas, start=1):
print(f"gamma_{i} = {g}")

# Z(x) check
def Z_partial(x, n):
return -sum(2.0*x/(x**2 + gammas[k]**2) for k in range(n))

x_test = 12.0
for n in range(1, 6):
print(f"n={n}: Z_partial({x_test}) = {Z_partial(x_test, n):.9f}")

# A,B check
A = math.exp(2*math.pi/gamma1)
B = math.exp(math.pi/gamma1)
print(f"\nA = {A}\nB = {B}\nA - B**2 = {A-B**2}")

# c2 check
c2 = 0.5*sum(math.log(g)/(g**4) for g in gammas)
print(f"\nc2 partial sum (5) = {c2:.12e}")
print(f"Required scale for 2.31 TeV = {2.31/c2:.4e} TeV")