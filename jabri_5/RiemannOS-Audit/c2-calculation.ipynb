import math

# The first 5 imaginary parts of non-trivial Riemann zeros
gammas = [14.134725, 21.022040, 25.010858, 30.424876, 32.935062]

def calculate_c2(n_zeros):
c2_sum = sum(math.log(gammas[k]) / (gammas[k]**4) for k in range(n_zeros))
return c2_sum / 2

print("--- Calculating c2 Partial Sums ---")
for n in [1,2,3,4,5]:
print(f"With {n} zeros: c2 = {calculate_c2(n):.8e}")

c2_5 = calculate_c2(5)
target = 2.31
scale = target / c2_5
print(f"\nCalculated c2 = {c2_5:.6e}")
print(f"Target = {target} TeV")
print(f"Required scale = {scale:.4e} TeV = {scale*1e3:.4e} GeV")
print("\nAudit: scale is unstated -> prediction is fitted, not derived")